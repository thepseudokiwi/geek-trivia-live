{
  "name": "geek-trivia-live",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "node --import tsx server/index.ts",
    "db:migrate": "node --import tsx server/db/migrate.ts",
    "db:seed": "node --import tsx server/db/seed.ts",
    "questions:import": "node --import tsx scripts/questionsImport.ts",
    "questions:stats": "node --import tsx scripts/questionsStats.ts",
    "buzzer:load": "node --import tsx scripts/buzzerLoad.ts",
    "fonts:import": "node --import tsx scripts/fontsImport.ts",
    "auth:hash": "node --import tsx scripts/hashHostPassword.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/auth-ui": "0.3.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@react-three/fiber": "^9.6.1",
    "@vercel/functions": "^3.9.5",
    "cannon-es": "0.20.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.2",
    "three": "^0.185.1",
    "ws": "^8.21.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.185.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "react-router": "7.18.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "core-js": false
  }
}

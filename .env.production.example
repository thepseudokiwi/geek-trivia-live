NODE_ENV=production
APP_ORIGIN=https://redshirtgeeks.tv
HOST_USERNAME=host
# Generate with: npm run auth:hash -- "your long unique password"
HOST_PASSWORD_HASH=scrypt$replace-with-generated-salt-and-hash
HOST_SESSION_SECRET=replace-with-at-least-32-random-characters
HOST_SESSION_HOURS=12
TRUST_PROXY=loopback
BIND_HOST=127.0.0.1
PORT=8787
DATABASE_PATH=/var/lib/nerd-wars/geek-trivia.db
# Neon Postgres. Keep both values secret; use the pooled URL for application traffic.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
# Public Neon Auth and Data API endpoints created for this Neon project.
# Vercel's beta resources are connected with a BETA_ prefix. The unprefixed
# names remain supported for self-hosted deployments.
BETA_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BETA_REDIS_URL=rediss://default:password@host:port
VITE_NEON_AUTH_URL=https://your-neon-auth-endpoint.neonauth.example
VITE_NEON_DATA_API_URL=https://your-neon-data-api-endpoint.example
# Comma-separated HTTPS origins allowed to serve player profile pictures.
PLAYER_AVATAR_ORIGINS=https://lh3.googleusercontent.com
# Upstash Redis is used only for cross-instance realtime fan-out on Vercel.
REDIS_URL=rediss://default:password@host:6379
# GOOGLE_FONTS_API_KEY=optional-restricted-key
